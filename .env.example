# Copy this file to .env and fill in real values for local development.
# NEVER commit real values. This file contains only safe placeholders.
#
# For local dev you can also use dotnet user-secrets:
#   dotnet user-secrets set "FalAi:ApiKey" "your-key" --project API
#
# For Render / GitHub Actions: set these as Environment Variables / Secrets.

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=vfr_dev;Username=postgres;Password=YOUR_DB_PASSWORD

# ── JWT RS256 ─────────────────────────────────────────────────────────────────
JwtSettings__PrivateKeyPem=YOUR_RSA_PRIVATE_KEY_PEM
JwtSettings__PublicKeyPem=YOUR_RSA_PUBLIC_KEY_PEM
JwtSettings__StepTokenSecret=YOUR_STEP_TOKEN_SECRET

# ── Email (Mailtrap / SendGrid) ───────────────────────────────────────────────
Email__Username=YOUR_SMTP_USERNAME
Email__Password=YOUR_SMTP_PASSWORD

# ── Cloudinary ────────────────────────────────────────────────────────────────
Cloudinary__CloudName=YOUR_CLOUD_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET

# ── fal.ai ────────────────────────────────────────────────────────────────────
FalAi__ApiKey=YOUR_FAL_AI_API_KEY

# ── Stripe ────────────────────────────────────────────────────────────────────
Stripe__SecretKey=YOUR_STRIPE_SECRET_KEY
Stripe__PublishableKey=YOUR_STRIPE_PUBLISHABLE_KEY
StripeSettings__WebhookSecret=YOUR_STRIPE_WEBHOOK_SECRET

# ── Google OAuth ──────────────────────────────────────────────────────────────
Google__ClientId=YOUR_GOOGLE_CLIENT_ID

# ── AWS S3 ────────────────────────────────────────────────────────────────────
S3__AccessKey=YOUR_AWS_ACCESS_KEY
S3__SecretKey=YOUR_AWS_SECRET_KEY

# ── WeatherAPI ────────────────────────────────────────────────────────────────
WeatherApi__ApiKey=YOUR_WEATHER_API_KEY

# ── AI Models (Modal.run) ─────────────────────────────────────────────────────
AiModels__MeasurementExtractionUrl=YOUR_MODAL_MEASUREMENT_URL
AiModels__StyleRecommendationUrl=YOUR_MODAL_STYLE_URL
AiModels__SimilarUrl=YOUR_MODAL_SIMILAR_URL

# ── Redis ─────────────────────────────────────────────────────────────────────
Redis__ConnectionString=localhost:6379

# ── Encryption ────────────────────────────────────────────────────────────────
EncryptionSettings__Key=YOUR_ENCRYPTION_KEY
