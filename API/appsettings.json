{

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 30
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 300
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },


  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "JwtSettings": {
    "Issuer": "VirtualFittingRoom",
    "Audience": "VirtualFittingRoomRetailers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RememberMeRefreshTokenExpiryDays": 30
  },

  "Email": {
    "Host": "smtp.mailtrap.io",
    "Port": 587,
    "SenderName": "Virtual Fitting Room",
    "SenderEmail": "noreply@vfr-platform.com"
  },

  "S3": {
    "BucketName": "vfr-retailer-assets-dev",
    "Region": "us-east-1",
    "BaseUrl": "https://vfr-retailer-assets-dev.s3.us-east-1.amazonaws.com"
  },

  "Google": {
    "ClientId": ""
  },
  "StripeSettings": {
    "WebhookSecret": ""
  },
  "EncryptionSettings": {
    "Key": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://your-frontend-app.vercel.app"
    ]
  },

  "AllowedHosts": "*"
}