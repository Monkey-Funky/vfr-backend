{
  "Admin": {
    "SecretKey": ""
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 30
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 300
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },


  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "JwtSettings": {
    "Issuer": "VirtualFittingRoom",
    "Audience": "VirtualFittingRoomRetailers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RememberMeRefreshTokenExpiryDays": 30
  },

  "Email": {
    "Host": "smtp.mailtrap.io",
    "Port": 587,
    "SenderName": "Virtual Fitting Room",
    "SenderEmail": "noreply@vfr-platform.com"
  },

  "S3": {
    "BucketName": "vfr-retailer-assets-dev",
    "Region": "us-east-1",
    "BaseUrl": "https://vfr-retailer-assets-dev.s3.us-east-1.amazonaws.com"
  },

  "Cloudinary": {
    "CloudName": "ddjzbouvr",
    "ApiKey": "",
    "ApiSecret": ""
  },

  "FalAi": {
    "ApiKey": "",
    "BodyApiId": "fal-ai/sam-3/3d-body",
    "ObjectsApiId": "fal-ai/sam-3/3d-objects",
    "AlignApiId": "fal-ai/sam-3/3d-align",
    "QueueBaseUrl": "https://queue.fal.run",
    "MaxPollSeconds": 120,
    "InitialPollDelayMs": 4000,
    "PollIntervalMs": 1500
  },

  "VirtualTryOn2D": {
    "Enabled": true,
    "Provider": "FalAi",
    "ModelId": "fal-ai/fashn/tryon",
    "TimeoutSeconds": 180
  },

  "Google": {
    "ClientId": ""
  },
  "StripeSettings": {
    "WebhookSecret": ""
  },

  "Stripe": {
    "SecretKey": "",
    "PublishableKey": ""
  },

  "AiGeneration": {
    "PipelineVersion": "2026-06-19-v1",
    "MaxPaidAvatarGenerationsPerDay": 5,
    "MaxPaidTryOnGenerationsPerDay": 20
  },

  "EncryptionSettings": {
    "Key": ""
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "AllowedHosts": "*"
}