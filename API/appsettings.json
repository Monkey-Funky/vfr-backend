{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=VirtualFittingRoomDb;Username=postgres;Password=CHANGE_IN_DEV_SETTINGS"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "VFR_"
  },
  "JwtSettings": {
    "Issuer": "VirtualFittingRoom",
    "Audience": "VirtualFittingRoomRetailers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "post:/api/auth/*",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}